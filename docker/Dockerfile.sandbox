# Minimal Python sandbox — no network, no extra packages
# Used for executing AI-generated code safely
FROM python:3.11-slim

# Only add safe data-science packages
RUN pip install --no-cache-dir \
    pandas \
    openpyxl \
    numpy \
    python-docx

WORKDIR /workspace

# Non-root user for additional security
RUN useradd -m sandbox
USER sandbox
