# ============================================
# Sovereign AI Workbench — Environment Config
# ============================================
# Copy to .env and modify as needed.
# ALL endpoints are LOCAL. No cloud API keys.

# --- Application ---
APP_NAME=Sovereign AI Workbench
APP_VERSION=0.1.0
APP_HOST=127.0.0.1
APP_PORT=8080
DEBUG=true
LOG_LEVEL=INFO

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen3:14b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=qwen3-vl:8b

# --- vLLM (Phase 25+) ---
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct

# --- LiteLLM (Phase 24+) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-local-sovereign-key

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=sovereign_documents

# --- Embedding ---
EMBEDDING_MODEL=qwen3-embedding-0.6b
EMBEDDING_DIMENSION=1024

# --- Reranker ---
RERANKER_MODEL=qwen3-reranker-0.6b

# --- Sandbox ---
SANDBOX_IMAGE=sovereign-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK=none

# --- Security ---
JWT_SECRET_KEY=change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Data Paths ---
DATA_DIR=./data
DOCUMENTS_DIR=./data/documents
PROCESSED_DIR=./data/processed
EMBEDDINGS_DIR=./data/embeddings
OUTPUT_DIR=./data/output

# --- Monitoring ---
OTEL_EXPORTER=console
SOVEREIGNTY_LOG_FILE=./monitoring/sovereignty.log
